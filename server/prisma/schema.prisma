generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Status / role fields are plain strings (SQLite); allowed values are
// enforced in src/lib/constants.ts and validated with Zod.

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  phone     String?
  password  String
  role      String    @default("CUSTOMER") // CUSTOMER | ADMIN
  isBlocked          Boolean @default(false)
  mustChangePassword Boolean @default(false) // set when an admin resets the password
  sessionVersion     Int     @default(0) // bump to sign the user out everywhere
  createdAt DateTime  @default(now())
  cartItems CartItem[]
  orders    Order[]
  bookings  Booking[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
}

model Product {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  description String
  price       Int // rupees
  mrp         Int? // original price, for showing discount
  stock       Int            @default(0)
  careLevel   String? // Easy | Moderate | Expert
  light       String?
  water       String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  categoryId  Int
  category    Category       @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  sortOrder Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CartItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  userId    Int
  productId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id            Int         @id @default(autoincrement())
  orderNumber   String      @unique
  status        String      @default("PLACED") // PLACED | CONFIRMED | SHIPPED | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  paymentMethod String      @default("COD")
  paymentStatus String      @default("PENDING") // PENDING | PAID
  subtotal      Int
  shippingFee   Int
  total         Int
  // shipping address snapshot
  fullName      String
  phone         String
  addressLine   String
  city          String
  state         String
  pincode       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userId        Int
  user          User        @relation(fields: [userId], references: [id])
  items         OrderItem[]
  history       OrderStatusHistory[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  name      String // snapshot
  image     String?
  price     Int
  quantity  Int
  orderId   Int
  productId Int?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  status    String
  note      String?
  createdAt DateTime @default(now())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Service {
  id              Int           @id @default(autoincrement())
  name            String
  slug            String        @unique
  shortDescription String
  description     String
  price           Int
  durationMinutes Int
  image           String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  slots           ServiceSlot[]
  bookings        Booking[]
}

// A bookable time window. serviceId null = usable for any service.
model ServiceSlot {
  id        Int       @id @default(autoincrement())
  startsAt  DateTime
  endsAt    DateTime
  status    String    @default("AVAILABLE") // AVAILABLE | BOOKED | BLOCKED
  serviceId Int?
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@index([startsAt])
}

model Booking {
  id            Int            @id @default(autoincrement())
  bookingNumber String         @unique
  status        String         @default("PENDING") // PENDING | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED
  price         Int
  fullName      String
  phone         String
  addressLine   String
  city          String
  pincode       String
  notes         String?
  adminNotes    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        Int
  serviceId     Int
  slotId        Int
  user          User           @relation(fields: [userId], references: [id])
  service       Service        @relation(fields: [serviceId], references: [id])
  slot          ServiceSlot    @relation(fields: [slotId], references: [id])
  images        BookingImage[]
  history       BookingStatusHistory[]
}

model BookingImage {
  id         Int      @id @default(autoincrement())
  url        String
  uploadedBy String // CUSTOMER | ADMIN
  caption    String?
  createdAt  DateTime @default(now())
  bookingId  Int
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingStatusHistory {
  id        Int      @id @default(autoincrement())
  status    String
  note      String?
  createdAt DateTime @default(now())
  bookingId Int
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
